# Configure these environment variables in your shell/deployment platform.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/citypulse
DB_USERNAME=citypulse
DB_PASSWORD=change_me_local_only
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (SMTP) — dùng App Password nếu dùng Gmail với 2FA
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@citypulse.vn
APP_BASE_URL=http://localhost:5173
